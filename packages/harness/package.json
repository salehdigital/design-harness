{
  "name": "@salehdigital/harness",
  "version": "0.1.0",
  "description": "CLI for managing design harnesses",
  "type": "module",
  "bin": {
    "harness": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "harnesses"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "prepack": "pnpm build && node ../../scripts/copy-harnesses.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Lint passed'"
  },
  "dependencies": {
    "@salehdigital/harness-core": "workspace:*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/salehdigital/design-harness.git",
    "directory": "packages/harness"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
